# vhs demo/vhs/loop.tape   (run from repo root; needs brew install vhs)
Output demo/runs/loop.gif
Set Shell "zsh"
Set FontSize 16
Set Width 1400
Set Height 820
Set Framerate 12
Set PlaybackSpeed 3.0
Set Theme "Catppuccin Mocha"
Type "npm run reset" Enter
Sleep 1s
Type "claude" Enter
Sleep 6s
Type '/ralph-loop:ralph-loop Triagera alla tickets enligt TRIAGE.md --completion-promise "ALLA TICKETS TRIAGERADE" --max-iterations 8'
Sleep 1s
Enter
Sleep 1s
Enter
Sleep 300s
