# vhs demo/vhs/graph.tape   (run from repo root; needs brew install vhs)
Output demo/runs/graph.gif
Set Shell "zsh"
Set FontSize 16
Set Width 1400
Set Height 820
Set Framerate 12
Set PlaybackSpeed 3.0
Set Theme "Catppuccin Mocha"
Type "claude" Enter
Sleep 6s
Enter
Sleep 3s
Type "/triage-graph"
Sleep 1s
Enter
Sleep 1s
Enter
Sleep 240s
